# Configurer les secrets dans Vercel, jamais dans le code client.
ADMIN_SECRET=
BLOB_READ_WRITE_TOKEN=
# Vercel AI Gateway utilise automatiquement son jeton OIDC côté serveur.
# Le compte Vercel doit être activé pour utiliser AI Gateway.
# Une clé Gateway facultative peut remplacer OIDC hors de Vercel.
AI_GATEWAY_API_KEY=
# Fournisseur alternatif : renseigner les trois valeurs ensemble (facultatif).
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=
# URL publique définitive (facultatif ; Vercel fournit son URL de production)
NEXT_PUBLIC_SITE_URL=
